#!/usr/bin/env bash
# panel-site-ssh-setup — enable SSH terminal access for a site user.
# Invoked via sudo by user 'panel' before opening a terminal session.
#   sudo panel-site-ssh-setup <domain>
#
# Sets bash shell (was nologin) + adds the panel's pubkey to the
# site user's authorized_keys so the terminal WebSocket can SSH in.
set -euo pipefail

DOMAIN_RE='^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$'

DOMAIN="${1:-}"

[ $# -eq 1 ] || { echo "usage: panel-site-ssh-setup <domain>" >&2; exit 64; }
DOMAIN="${DOMAIN,,}"
[[ "$DOMAIN" =~ $DOMAIN_RE ]] || { echo "panel-site-ssh-setup: invalid domain" >&2; exit 64; }

SITE_ROOT="/var/www/$DOMAIN"
SITE_USER="site-$(printf '%s' "$DOMAIN" | md5sum | cut -c1-8)"
id -u "$SITE_USER" &>/dev/null || { echo "panel-site-ssh-setup: site not found" >&2; exit 66; }

# Enable login shell (was /usr/sbin/nologin)
chsh -s /bin/bash "$SITE_USER" 2>/dev/null || true

# Setup SSH key
PANEL_PUBKEY="$(cat /opt/panel/etc/ssh_key.pub)"
mkdir -p "$SITE_ROOT/.ssh"
echo "$PANEL_PUBKEY" > "$SITE_ROOT/.ssh/authorized_keys"
chown -R "$SITE_USER:$SITE_USER" "$SITE_ROOT/.ssh"
chmod 0700 "$SITE_ROOT/.ssh"
chmod 0600 "$SITE_ROOT/.ssh/authorized_keys"

echo "OK: SSH terminal enabled for $SITE_USER ($DOMAIN)"
