#!/usr/bin/env bash
# ============================================================
# panel-node-deploy — deploy a Node.js application for one site.
# Invoked via sudo by user 'panel'; all arguments are validated.
#
#   panel-node-deploy <domain> <siteId> <repo> <branch> <nodeVer> <buildCmd> <startCmd> <port>
#
# Flow: git fetch/checkout → build into releases/<ts> → flip the
#       current symlink → write the app-<siteId> systemd unit →
#       restart → health check. On health check failure the previous
#       release is restored automatically.
# git and the build run as the SITE USER (not root); root only
# writes the unit, the symlink, and manages systemd. Private SSH
# keys are not supported yet (public https repos or local paths).
# ============================================================
set -euo pipefail

DOMAIN_RE='^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$'
BRANCH_RE='^[a-zA-Z0-9._/-]+$'
CMD_RE='^[a-zA-Z0-9 ./_:=@&>-]*$'          # build/start charset: allows && for chaining
                                                             # still blocks ; | $ ` ( ) backtick
REPO_RE='^(https://[a-zA-Z0-9./_:~@-]+|/[a-zA-Z0-9./_-]+)$'

DOMAIN="${1:-}"; SITE_ID="${2:-}"; REPO="${3:-}"; BRANCH="${4:-}"
NVER="${5:-}"; BUILD="${6:-}"; START="${7:-}"; PORT="${8:-}"

usage() { echo "usage: panel-node-deploy <domain> <siteId> <repo> <branch> <nodeVer> <buildCmd> <startCmd> <port>" >&2; exit 64; }
fail()  { echo "panel-node-deploy: $*" >&2; exit 1; }

[ $# -eq 8 ] || usage
DOMAIN="${DOMAIN,,}"
[[ "$DOMAIN" =~ $DOMAIN_RE ]] || fail "invalid domain: $DOMAIN"
[[ "$SITE_ID" =~ ^[0-9]+$ ]] || fail "siteId must be numeric"
[[ "$REPO" =~ $REPO_RE ]] || fail "invalid repo: $REPO"
[[ "$BRANCH" =~ $BRANCH_RE ]] || fail "invalid branch: $BRANCH"
[[ "$NVER" =~ ^[0-9]+$ ]] || fail "invalid node version: $NVER"
[[ "$BUILD" =~ $CMD_RE ]] || fail "buildCmd contains forbidden characters"
[[ "$START" =~ $CMD_RE ]] || [ -z "$START" ] || fail "startCmd contains forbidden characters"
[ -n "$START" ] || fail "startCmd is required"
[[ "$PORT" =~ ^[0-9]{5}$ ]] && [ "$PORT" -ge 30000 ] && [ "$PORT" -le 39999 ] || fail "invalid port: $PORT"
[[ "$REPO" != *".."* ]] || fail "repo contains '..'"

NODEBIN="/opt/node/v$NVER/bin"
[ -x "$NODEBIN/node" ] || fail "Node v$NVER is not installed at $NODEBIN"

SITE_ROOT="/var/www/$DOMAIN"
SITE_USER="site-$(printf '%s' "$DOMAIN" | md5sum | cut -c1-8)"
id -u "$SITE_USER" &>/dev/null || fail "site not created yet in the panel (user $SITE_USER missing)"

mkdir -p "$SITE_ROOT"/{repo,releases,shared,logs}
chown -R "$SITE_USER:$SITE_USER" "$SITE_ROOT"

# All git/build operations run as the site user, with the chosen node in PATH
RUN() { runuser -u "$SITE_USER" -- env PATH="$NODEBIN:$PATH" "$@"; }

echo "[1/6] Fetching code (repo: $REPO, branch: $BRANCH)..."

# --- Private repo support: inject GitHub token if configured ---
GIT_TOKEN_FILE="/opt/panel/etc/git_token"
CLONE_URL="$REPO"

if [ -s "$GIT_TOKEN_FILE" ] && [[ "$REPO" == https://github.com/* ]]; then
    GIT_TOKEN="$(cat "$GIT_TOKEN_FILE")"
    # Inject token: https://github.com/user/repo.git → https://x-access-token:TOKEN@github.com/user/repo.git
    CLONE_URL="${REPO/https:\/\//https:\/\/x-access-token:${GIT_TOKEN}@}"
    echo "  (private repo: using GitHub token)"
fi

if [ ! -d "$SITE_ROOT/repo/.git" ]; then
    RUN git clone "$CLONE_URL" "$SITE_ROOT/repo" >/dev/null 2>&1 || {
        # If clone failed with token, try without (might be public)
        if [ "$CLONE_URL" != "$REPO" ]; then
            RUN git clone "$REPO" "$SITE_ROOT/repo" >/dev/null 2>&1 || \
                fail "git clone failed (check token in Settings → Git Credentials, or repo URL)"
        else
            fail "git clone failed (public repo/valid path?)"
        fi
    }
fi

# For fetch, inject token too (private repos need it every time)
FETCH_URL="$CLONE_URL"
if [ ! -d "$SITE_ROOT/repo/.git" ]; then
    RUN git -C "$SITE_ROOT/repo" fetch origin --prune >/dev/null 2>&1 || fail "git fetch failed"
else
    # Update remote URL if token changed (idempotent)
    CURRENT_URL="$(RUN git -C "$SITE_ROOT/repo" remote get-url origin 2>/dev/null || echo "")"
    if [ "$CURRENT_URL" != "$FETCH_URL" ] && [ "$FETCH_URL" != "$REPO" ]; then
        RUN git -C "$SITE_ROOT/repo" remote set-url origin "$FETCH_URL" >/dev/null 2>&1 || true
    fi
    RUN git -C "$SITE_ROOT/repo" fetch origin --prune >/dev/null 2>&1 || {
        # Try with fresh URL if fetch fails
        RUN git -C "$SITE_ROOT/repo" remote set-url origin "$FETCH_URL" >/dev/null 2>&1 || true
        RUN git -C "$SITE_ROOT/repo" fetch origin --prune >/dev/null 2>&1 || fail "git fetch failed (check token or branch)"
    }
fi

RUN git -C "$SITE_ROOT/repo" checkout -f "$BRANCH" >/dev/null 2>&1 || fail "branch $BRANCH not found"
RUN git -C "$SITE_ROOT/repo" reset --hard "origin/$BRANCH" >/dev/null 2>&1 \
    || RUN git -C "$SITE_ROOT/repo" reset --hard "$BRANCH" >/dev/null 2>&1 \
    || fail "failed to reset to branch"

echo "[2/6] Building new release..."
TS="$(date +%Y%m%d-%H%M%S)"
REL="$SITE_ROOT/releases/$TS"
mkdir -p "$REL"
chown "$SITE_USER:$SITE_USER" "$REL"
RUN cp -a "$SITE_ROOT/repo/." "$REL/"
# install deps (prefer npm ci for exact lockfile + all platform binaries),
# run optional build, then strip devDependencies.
# Fail FAST on any error — don't continue to health check if build fails.
RUN bash -c "cd '$REL' && [ -f package.json ] || { echo 'package.json not found in repo' >&2; exit 1; }
if [ -f package-lock.json ]; then
    npm ci --no-audit --no-fund 2>&1 | tail -3
else
    npm install --no-audit --no-fund 2>&1 | tail -3
fi
# FIX: lockfiles created on other OS may miss linux platform binaries.
# Install them explicitly (lightningcss, swc, esbuild are the common offenders).
npm install lightningcss-linux-x64-gnu @tailwindcss/oxide-linux-x64-gnu --no-save --no-audit --no-fund 2>/dev/null || true
" || fail "npm install failed (check package.json / lockfile compatibility)"
RUN ln -sfn ../shared/.env "$REL/.env"

# Run build command if specified — MUST succeed or we abort immediately
if [ -n "$BUILD" ]; then
    RUN bash -c "cd '$REL' && $BUILD" || {
        rm -rf "$REL"
        fail "BUILD FAILED — fix build errors and retry"
    }
fi

# Strip devDependencies (only if build succeeded)
RUN bash -c "cd '$REL' && npm prune --omit=dev 2>&1 | tail -1" || true

# Next.js standalone optimization: if .next/standalone exists, remove
# the full node_modules (standalone has its own minimal set) and copy
# static assets into the standalone directory.
# All ops run as ROOT (we're deleting anyway) then fix ownership at end.
if [ -d "$REL/.next/standalone" ]; then
    echo "  Next.js standalone detected — optimizing..."
    # copy static assets into standalone (as root, then fix perms)
    if [ -d "$REL/.next/static" ]; then
        mkdir -p "$REL/.next/standalone/.next/static"
        cp -a "$REL/.next/static/." "$REL/.next/standalone/.next/static/"
    fi
    if [ -d "$REL/public" ] && [ ! -d "$REL/.next/standalone/public" ]; then
        cp -a "$REL/public" "$REL/.next/standalone/public"
    fi
    # remove the full node_modules (standalone has its own)
    rm -rf "$REL/node_modules"
    # remove .next except standalone (static already copied)
    find "$REL/.next" -maxdepth 1 -mindepth 1 ! -name 'standalone' -exec rm -rf {} + 2>/dev/null || true
    # fix ownership for the site user
    chown -R "$SITE_USER:$SITE_USER" "$REL"
    echo "  optimized: $(du -sh "$REL" | cut -f1) (was ~600MB with full node_modules)"
fi

echo "[3/6] Installing systemd unit app-$SITE_ID..."
# Map the first startCmd token to the absolute binary of the chosen node version
first_tok="${START%% *}"; rest="${START#"$first_tok"}"; rest="${rest#"${rest%%[! ]*}"}"
case "$first_tok" in
    node | npm | npx | yarn | pnpm) EXEC="$NODEBIN/$first_tok $rest" ;;
    /*) EXEC="$START" ;;
    *) fail "startCmd must start with 'node'/'npm'/... or an absolute path" ;;
esac

UNIT="/etc/systemd/system/app-$SITE_ID.service"
cat > "$UNIT" <<EOF
# managed by panel — do not edit by hand
[Unit]
Description=app-$SITE_ID ($DOMAIN) - managed by panel
After=network.target

[Service]
User=$SITE_USER
Group=$SITE_USER
WorkingDirectory=$SITE_ROOT/current
Environment=NODE_ENV=production
Environment=PORT=$PORT
Environment=PATH=$NODEBIN:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=-$SITE_ROOT/shared/.env
ExecStart=$EXEC
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload
systemctl enable "app-$SITE_ID" >/dev/null

echo "[4/6] Activating release $TS..."
PREV="$(readlink "$SITE_ROOT/current" 2>/dev/null || true)"
ln -sfn "$REL" "$SITE_ROOT/current"
systemctl restart "app-$SITE_ID"

echo "[5/6] Health check on 127.0.0.1:$PORT (max 45s)..."
ok=""
for _ in $(seq 1 45); do
    sleep 1
    if curl -s -o /dev/null --max-time 2 "http://127.0.0.1:$PORT/"; then ok=1; break; fi
done
if [ -z "$ok" ]; then
    echo "HEALTH CHECK FAILED — application is not responding on port $PORT" >&2
    if [ -n "$PREV" ]; then
        echo "Rolling back to previous release: $PREV" >&2
        ln -sfn "$PREV" "$SITE_ROOT/current"
        systemctl restart "app-$SITE_ID"
    fi
    exit 1
fi

echo "[6/6] Pruning old releases..."
# Read per-site retention from panel-node-releases helper (default 5)
RETENTION_COUNT="$(/opt/panel/bin/panel-node-releases get-retention "$DOMAIN" 2>/dev/null || echo 5)"
cd "$SITE_ROOT/releases"
ls -1 | sort | head -n -"$RETENTION_COUNT" | while read -r old; do rm -rf "$SITE_ROOT/releases/$old"; done
echo "  kept $RETENTION_COUNT releases"

echo "OK: $DOMAIN deployed (release $TS, unit app-$SITE_ID active)"
