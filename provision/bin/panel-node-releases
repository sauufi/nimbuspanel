#!/usr/bin/env bash
# ============================================================
# panel-node-releases — manage release versions for node sites.
# Invoked via sudo by user 'panel'.
#
#   panel-node-releases list <domain>              → name|sizeMb|date lines
#   panel-node-releases delete <domain> <name>     → delete one release
#   panel-node-releases retention <domain> <N>     → set retention (1-20)
#
# Retention is stored per-site in panel.db meta table.
# Used by the deploy script to prune old releases.
# ============================================================
set -euo pipefail

DOMAIN_RE='^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$'
REL_RE='^[0-9]{8}-[0-9]{6}$'
PANEL_DB="/opt/panel/etc/panel.db"

fail() { echo "panel-node-releases: $*" >&2; exit 1; }

ACTION="${1:-}"
DOMAIN="${2:-}"

[ -n "$DOMAIN" ] || fail "domain required"
DOMAIN="${DOMAIN,,}"
[[ "$DOMAIN" =~ $DOMAIN_RE ]] || fail "invalid domain"

SITE_ROOT="/var/www/$DOMAIN"
REL_DIR="$SITE_ROOT/releases"

get_meta() {
    sqlite3 "$PANEL_DB" "SELECT value FROM meta WHERE key='$1';" 2>/dev/null || echo ""
}

set_meta() {
    sqlite3 "$PANEL_DB" "INSERT INTO meta (key, value) VALUES ('$1', '$2')
        ON CONFLICT(key) DO UPDATE SET value = excluded.value;" 2>/dev/null
}

RETENTION_KEY="release_retention_site_${DOMAIN//./_}"

case "$ACTION" in
    list)
        [ -d "$REL_DIR" ] || { echo "(no releases)"; exit 0; }
        for rel in $(ls -1 "$REL_DIR" 2>/dev/null | sort -r); do
            [ -d "$REL_DIR/$rel" ] || continue
            SIZE=$(du -sm "$REL_DIR/$rel" 2>/dev/null | cut -f1)
            DATE=$(stat -c %Y "$REL_DIR/$rel" 2>/dev/null || echo 0)
            DATE_STR=$(date -d @"$DATE" '+%Y-%m-%d %H:%M' 2>/dev/null || echo '')
            echo "${rel}|${SIZE}|${DATE_STR}"
        done
        ;;
    delete)
        REL_NAME="${3:-}"
        [ $# -eq 3 ] || fail "usage: delete <domain> <release>"
        [[ "$REL_NAME" =~ $REL_RE ]] || fail "invalid release name: $REL_NAME"

        # Prevent deleting active release
        CURRENT=$(readlink "$SITE_ROOT/current" 2>/dev/null | xargs basename 2>/dev/null || echo "")
        [ "$REL_NAME" = "$CURRENT" ] && fail "cannot delete the active release"

        [ -d "$REL_DIR/$REL_NAME" ] || fail "release not found: $REL_NAME"
        rm -rf "$REL_DIR/$REL_NAME"
        echo "OK: release $REL_NAME deleted"
        ;;
    retention)
        RETENTION_VAL="${3:-}"
        [ $# -eq 3 ] || fail "usage: retention <domain> <count>"
        [[ "$RETENTION_VAL" =~ ^[0-9]+$ ]] && [ "$RETENTION_VAL" -ge 1 ] && [ "$RETENTION_VAL" -le 20 ] \
            || fail "retention must be 1-20"

        set_meta "$RETENTION_KEY" "$RETENTION_VAL"
        echo "OK: retention set to $RETENTION_VAL for $DOMAIN"
        ;;
    get-retention)
        RETENTION_VAL="$(get_meta "$RETENTION_KEY")"
        [ -n "$RETENTION_VAL" ] || RETENTION_VAL="5"
        echo "$RETENTION_VAL"
        ;;
    *)
        fail "unknown action: $ACTION (use list|delete|retention)"
        ;;
esac
