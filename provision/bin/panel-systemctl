#!/usr/bin/env bash
# ============================================================
# panel-systemctl — systemctl wrapper for the panel backend.
# Invoked via sudo by user 'panel'. All arguments are treated as
# UNTRUSTED and validated before being passed through.
#
#   sudo /opt/panel/bin/panel-systemctl <action> <unit>
#
# Actions: reload | restart | status | is-active (stop/disable not allowed)
# Units  : nginx, php<X>-fpm, apache2, panel, app-*  (panel-managed only)
# ============================================================
set -euo pipefail

ACTION="${1:-}"
UNIT="${2:-}"

usage() { echo "usage: panel-systemctl <reload|restart|status|is-active> <nginx|apache2|php<X.Y>-fpm|app-*>" >&2; exit 64; }

[ $# -eq 2 ] || usage
case "$ACTION" in
    reload | restart | status | is-active) ;;
    *) usage ;;
esac
case "$UNIT" in
    nginx | nginx.service) ;;
    apache2 | apache2.service) ;;
    panel | panel.service) ;;
    mariadb | mariadb.service) ;;
    postfix | postfix.service) ;;
    dovecot | dovecot.service) ;;
    opendkim | opendkim.service) ;;
    fail2ban | fail2ban.service) ;;
    php[0-9].[0-9]-fpm | php[0-9].[0-9]-fpm.service) ;;
    app-* | app-*.service) ;;
    *) echo "panel-systemctl: unit not allowed: $UNIT" >&2; exit 77 ;;
esac

exec /usr/bin/systemctl "$ACTION" "$UNIT"
