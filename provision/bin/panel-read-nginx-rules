#!/usr/bin/env bash
# panel-read-nginx-rules — print a site's custom nginx rules file.
#   sudo panel-read-nginx-rules <domain>
set -euo pipefail

DOMAIN_RE='^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$'
RULES_DIR="/etc/nginx/panel-rules"

DOMAIN="${1:-}"

[ $# -eq 1 ] || { echo "usage: panel-read-nginx-rules <domain>" >&2; exit 64; }
DOMAIN="${DOMAIN,,}"
[[ "$DOMAIN" =~ $DOMAIN_RE ]] || { echo "panel-read-nginx-rules: invalid domain" >&2; exit 64; }

F="$RULES_DIR/$DOMAIN.conf"
if [ -f "$F" ]; then
    cat "$F"
else
    printf '# (no custom rules yet)\n'
fi
